# Google Gemini API Key (Ottieni una chiave gratuita da Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# --- CONFIGURAZIONE NOTIFICHE WHATSAPP ---
# OPZIONE A (Super semplice, gratuita, nessun server): Usa CallMeBot
# Invia un messaggio WhatsApp con scritto "I allow callmebot to send me messages" al numero +34 623 78 64 49
# per ricevere all'istante la tua API Key. Poi inseriscila qui sotto:
CALLMEBOT_API_KEY=

# OPZIONE B (Gateway reale): Evolution API o Z-API (lascia vuoto se usi l'Opzione A)
WHATSAPP_GATEWAY_URL=
WHATSAPP_INSTANCE_ID=
WHATSAPP_TOKEN=

# Numero di telefono su cui desideri ricevere la notifica WhatsApp (es. +393456789012)
COMPANY_DESTINATION_NUMBER=
